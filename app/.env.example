# Where the SQLite database file lives (directory must be writable)
DATABASE_URL=./data/salon.db
# Where punch photos are stored on disk
PHOTO_DIR=./data/photos
# Public origin of the app, used for CSRF checks and links in statements
ORIGIN=http://localhost:5173
# 32+ random characters; used to sign share links
APP_SECRET=change-me-to-a-long-random-string
# Optional: set to "1" to let the first visitor create the first salon (bootstrap)
ALLOW_SIGNUP=1
